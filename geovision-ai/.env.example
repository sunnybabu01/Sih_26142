# ==========================================
# GeoVision AI Platform - Environment Config
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=geovision_satellite_srm_secret_key_2026

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/geovision_ai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/geovision_ai?retryWrites=true&w=majority

# AI Processing Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# File Storage Configuration
MAX_UPLOAD_SIZE_MB=100
UPLOADS_DIR=../uploads
OUTPUTS_DIR=../outputs

# Frontend Config
VITE_API_URL=http://localhost:5000/api
